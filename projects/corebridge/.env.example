# -*- coding: utf-8 -*-
# CoreBridge 项目环境变量模板
#
# 用法: 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略, 不入库）
#   cp projects/corebridge/.env.example projects/corebridge/.env
#
# 真实值来源: docs/CoreBridge_多租户前端工作台测试用例.md「一、测试账号与租户说明」
# 账号字段说明:
#   - u-A/u-B  单租户账号 (tenant + workbenchId + appId)
#   - u-X      同账号跨租户 (tenants 列表, 两个租户各一对 workbenchId/appId)
#   - u-N      空租户账号 (无 workbenchId/appId)
#   - u-F      冻结账号 (frozen), u-S 停用账号 (suspended) —— 标记当前代码不读取, 仅存档
#   - username/tenant 为测试断言语义标签, 留在 project.yaml; 此处只需填 hex ID

# ---- 服务地址（有默认值, 如需覆盖取消注释）----
# CB_BASE_URL=http://117.187.178.246:19521/login?redirect=/workbench
# CB_API_BASE=http://117.187.178.246:19521

# ---- 账号 hex ID（必填, 无默认值）----
# u-A (租户2 / zh2)
CB_UA_USER_ID=
CB_UA_WB_ID=
CB_UA_APP_ID=

# u-B (租户1 / zh1)
CB_UB_USER_ID=
CB_UB_WB_ID=
CB_UB_APP_ID=

# u-X (同账号跨租户 / test)
CB_UX_USER_ID=
CB_UX_T1_WB_ID=
CB_UX_T1_APP_ID=
CB_UX_T2_WB_ID=
CB_UX_T2_APP_ID=

# u-N (空租户 / kong)
CB_UN_USER_ID=

# u-F (冻结 / dj)
CB_UF_USER_ID=
CB_UF_WB_ID=
CB_UF_APP_ID=

# u-S (停用 / ty-user)
CB_US_USER_ID=
CB_US_WB_ID=
CB_US_APP_ID=
